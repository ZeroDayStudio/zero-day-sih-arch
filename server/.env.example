PORT=5000
NODE_ENV=development
# In development, the placeholder below automatically uses an ephemeral MongoDB.
# Set a real URI for persistent data; production always requires one.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3003